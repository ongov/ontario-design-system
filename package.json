{
	"name": "root",
	"version": "9.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build-libs": "lerna run --scope @ongov/ontario-design-system* build",
		"build-apps": "lerna run build --scope 'app-*' --ignore 'app-web-components-documentation'",
		"clean": "lerna run clean",
		"clean:docs": "rm -rf ./packages/docusaurus",
		"clean:full": "lerna run clean:full && pnpm clean:docs",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"prepare": "husky install",
		"refresh": "pnpm run clean && pnpm install && pnpm run build-libs",
		"semantic-release": "semantic-release",
		"test:e2e": "pnpm run test:e2e:stencil && pnpm run build-libs && pnpm run test:e2e:apps",
		"test:e2e:stencil": "lerna run test:e2e --scope '@ongov/ontario-design-system-component-library'",
		"test:e2e:apps": "lerna run test:e2e --scope 'app-*' --ignore 'app-web-components-documentation'",
		"test:e2e:docker": "pnpm -r run test:e2e:docker",
		"test:e2e:stencil:docker": "pnpm --filter @ongov/ontario-design-system-component-library run test:e2e:docker",
		"test:e2e:apps:docker": "pnpm --filter 'app-*' --filter '!app-web-components-documentation' run test:e2e:docker",
		"test:unit": "lerna run test:unit",
		"test:vrt": "pnpm run test:vrt:stencil && pnpm run build-libs && pnpm run test:vrt:apps",
		"test:vrt:stencil": "lerna run test:vrt --scope '@ongov/ontario-design-system-component-library'",
		"test:vrt:apps": "lerna run test:vrt --scope 'app-*' --ignore 'app-web-components-documentation'",
		"test:vrt:docker": "pnpm -r run test:vrt:docker",
		"test:vrt:stencil:docker": "pnpm --filter @ongov/ontario-design-system-component-library run test:vrt:docker",
		"test:update-snapshots": "lerna run test:update-snapshots",
		"test:update-snapshots:docker": "pnpm -r run test:update-snapshots:docker",
		"test:all": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:vrt"
	},
	"engines": {
		"node": "<25",
		"pnpm": "<12"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.0",
		"@semantic-release/github": "12.0.9",
		"@semantic-release/npm": "^13.1.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.0.0",
		"bash-color": "^0.0.4",
		"commander": "^15.0.0",
		"dotenv": "^17.0.0",
		"husky": "^9.0.0",
		"js-yaml": "^5.0.0",
		"lerna": "^10.0.0",
		"prettier": "^3.3.3",
		"pretty-quick": "^4.0.0",
		"semantic-release": "^25.0.2",
		"semantic-release-lerna": "^3.0.0",
		"tsx": "^4.20.5"
	},
	"optionalDependencies": {
		"@nrwl/nx-darwin-arm64": "15.9.3",
		"@nrwl/nx-darwin-x64": "15.9.3",
		"@nrwl/nx-linux-arm-gnueabihf": "15.9.3",
		"@nrwl/nx-linux-arm64-gnu": "15.9.3",
		"@nrwl/nx-linux-arm64-musl": "15.9.3",
		"@nrwl/nx-linux-x64-gnu": "15.9.3",
		"@nrwl/nx-linux-x64-musl": "15.9.3",
		"@nrwl/nx-win32-arm64-msvc": "15.9.3",
		"@nrwl/nx-win32-x64-msvc": "15.9.3",
		"bl": "^7.0.0"
	},
	"packageManager": "pnpm@11.20.0"
}
