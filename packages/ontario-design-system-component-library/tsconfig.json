{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"allowUnreachableCode": false,
		"declaration": false,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"lib": ["dom", "es2017", "ESNext.Disposable"],
		"module": "esnext",
		"target": "ES2017",
		"moduleResolution": "node10",
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"jsx": "react",
		"jsxFactory": "h",
		"resolveJsonModule": true,
		"types": ["node", "uuid", "react", "react-dom"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/utils/tests"],
	"paths": {
		"@ongov/ontario-design-system-design-tokens/*": ["node_modules/@ongov/ontario-design-system-design-tokens/*"]
	},
	"ts-node": {
		// these options are overrides used only by ts-node
		"compilerOptions": {
			"module": "commonjs",
			"target": "esnext"
		}
	}
}
