{
	"name": "@ongov/ontario-design-system-component-html-generator",
	"version": "9.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/ongov/ontario-design-system",
		"directory": "packages/ontario-design-system-component-html-generator"
	},
	"description": "Generates static HTML samples for Ontario Design System web components.",
	"private": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"odscompgen": "dist/cli.js",
		"ontario-design-system-component-html-generator": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc && pnpm run docs:copy:readme",
		"docs:copy:readme": "tsx ../../scripts/documentation-helper.ts -f README.md -p \"---\ntitle: HTML Sample Generator\n---\n\" --df ../docusaurus/docs/07-readme-html-sample-generator.md",
		"start": "node dist/cli.js",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"ontario",
		"design-system",
		"docs",
		"samples"
	],
	"author": "",
	"license": "Apache-2.0",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"dependencies": {
		"@ongov/ontario-design-system-component-library": "workspace:*",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@stencil/core": "^4.38.3",
		"@types/node": "^24.10.1",
		"puppeteer": "^25.0.0",
		"tsx": "^4.20.5",
		"typescript": "^6.0.0",
		"vitest": "^4.1.8"
	}
}
