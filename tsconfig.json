{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@ongov/*": ["packages/*"]
		},
		"target": "es6",
		"module": "commonjs",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["node"]
	},
	"include": ["packages/**/*", "scripts/**/*"],
	"exclude": ["node_modules"]
}
